<?xml version="1.0" encoding="utf-8"?>
<!-- Notification sounds and the notification icon are looked up by name at
     runtime (RawResourceAndroidNotificationSound, AndroidInitializationSettings),
     which resource shrinking can't see, so release builds would otherwise drop
     them as unused. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/reminder,@raw/notify,@raw/alarm_gentle,@raw/alarm_important_knock,@raw/alarm_important_marimba,@raw/insight,@drawable/ic_stat_lifeos" />
